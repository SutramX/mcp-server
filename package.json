{
  "name": "@sutramx/mcp-server",
  "version": "0.1.2",
  "mcpName": "io.github.SutramX/mcp-server",
  "description": "Model Context Protocol server for SutramX uptime monitoring: lets AI agents and assistants manage monitors, incidents and status pages.",
  "license": "MIT",
  "author": {
    "name": "SutramX",
    "email": "support@sutramx.com",
    "url": "https://sutramx.com"
  },
  "homepage": "https://github.com/SutramX/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SutramX/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/SutramX/mcp-server/issues",
    "email": "support@sutramx.com"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "sutramx",
    "uptime",
    "uptime-monitoring",
    "monitoring",
    "incidents",
    "status-page",
    "ai-agents",
    "claude"
  ],
  "type": "module",
  "bin": {
    "sutramx-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check-version": "node scripts/check-version.mjs",
    "prepublishOnly": "npm run check-version && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
